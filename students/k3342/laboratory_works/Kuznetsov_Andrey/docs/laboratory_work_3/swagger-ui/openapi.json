definitions:
  Agency:
    required:
    - name
    - address
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      name:
        title: Name
        type: string
        maxLength: 255
        minLength: 1
      address:
        title: Address
        type: string
        maxLength: 255
        minLength: 1
  Producer:
    required:
    - name
    - address
    - phone
    - email
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      name:
        title: Name
        type: string
        maxLength: 30
        minLength: 1
      address:
        title: Address
        type: string
        maxLength: 255
        minLength: 1
      phone:
        title: Phone
        type: string
        maxLength: 255
        minLength: 1
      email:
        title: Email
        type: string
        maxLength: 10
        minLength: 1
  Product:
    required:
    - producer
    - name
    - production_date
    - expiration_date
    - unit
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      producer:
        $ref: '#/definitions/Producer'
      name:
        title: Name
        type: string
        maxLength: 50
        minLength: 1
      production_date:
        title: Production date
        type: string
        format: date
      expiration_date:
        title: Expiration date
        type: string
        format: date
      unit:
        title: Unit
        type: string
        maxLength: 50
        minLength: 1
  BatchProduct:
    required:
    - product
    - batch
    - quantity
    - price_per_unit
    type: object
    properties:
      product:
        $ref: '#/definitions/Product'
      batch:
        title: Batch
        type: integer
      quantity:
        title: Quantity
        type: integer
        maximum: 9223372036854775807
        minimum: -9223372036854775808
      price_per_unit:
        title: Price per unit
        type: string
        format: decimal
  Broker:
    required:
    - agency
    - name
    - fixed_monthly_fee
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      agency:
        $ref: '#/definitions/Agency'
      name:
        title: Name
        type: string
        maxLength: 30
        minLength: 1
      fixed_monthly_fee:
        title: Fixed monthly fee
        type: string
        format: decimal
  Batch:
    required:
    - broker
    - batch_products
    - supply_conditions
    - contract_date
    - shipment_date
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      broker:
        $ref: '#/definitions/Broker'
      batch_products:
        type: array
        items:
          $ref: '#/definitions/BatchProduct'
      supply_conditions:
        title: Supply conditions
        type: string
        enum:
        - prepayment
        - no_prepayment
      contract_date:
        title: Contract date
        type: string
        format: date
      shipment_date:
        title: Shipment date
        type: string
        format: date
  ClientPurchase:
    required:
    - batch
    - quantity
    - purchase_date
    - total_price
    - client
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      batch:
        $ref: '#/definitions/Batch'
      quantity:
        title: Quantity
        type: integer
        maximum: 9223372036854775807
        minimum: -9223372036854775808
      purchase_date:
        title: Purchase date
        type: string
        format: date
      total_price:
        title: Total price
        type: string
        format: decimal
      client:
        title: Client
        type: integer
  ClientLoyalty:
    required:
    - name
    - total_purchases
    - total_spent
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      name:
        title: Name
        type: string
